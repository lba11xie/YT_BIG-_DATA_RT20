# ============================================================
#  Big Data YouTube Analytics - Configuration EXAMPLE
#  Copy this file to config.py and fill in your own values,
#  OR set the environment variables listed below.
# ============================================================

import os

# ---- YouTube & Gemini API Keys ----
# Set env vars:  YOUTUBE_API_KEY  /  GEMINI_API_KEY_1  /  GEMINI_API_KEY_2
YOUTUBE_API_KEY = os.getenv("YOUTUBE_API_KEY", "YOUR_YOUTUBE_API_KEY_HERE")

GEMINI_API_KEYS = [
    os.getenv("GEMINI_API_KEY_1", "YOUR_GEMINI_API_KEY_1_HERE"),
    os.getenv("GEMINI_API_KEY_2", "YOUR_GEMINI_API_KEY_2_HERE"),
]

# ---- Collection Settings ----
REGION_CODE            = "IN"
MAX_RESULTS_PER_PAGE   = 50
TOTAL_VIDEOS_TO_FETCH  = 200
COMMENTS_PER_VIDEO     = 20

# ---- MySQL Database ----
# Set env vars:  DB_HOST  DB_PORT  DB_USER  DB_PASSWORD  DB_NAME
DB_HOST     = os.getenv("DB_HOST",     "localhost")
DB_PORT     = int(os.getenv("DB_PORT", "3306"))
DB_USER     = os.getenv("DB_USER",     "root")
DB_PASSWORD = os.getenv("DB_PASSWORD", "YOUR_DB_PASSWORD_HERE")
DB_NAME     = os.getenv("DB_NAME",     "yt_bigdata")

# SQLAlchemy connection URL
DB_URL = f"mysql+pymysql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}:{DB_PORT}/{DB_NAME}"

# JDBC URL for Spark
JDBC_URL        = f"jdbc:mysql://{DB_HOST}:{DB_PORT}/{DB_NAME}?useSSL=false&serverTimezone=UTC"
JDBC_DRIVER     = "com.mysql.cj.jdbc.Driver"
JDBC_DRIVER_PATH = r"c:\JELLYFISH\YT_BD\YT_BD\setup\mysql-connector-java.jar"  # Update to your path

# ---- Data Paths (update to your local paths) ----
RAW_DATA_DIR       = r"c:\JELLYFISH\YT_BD\YT_BD\data\raw"
PROCESSED_DATA_DIR = r"c:\JELLYFISH\YT_BD\YT_BD\data\processed"
VIDEOS_CSV         = r"c:\JELLYFISH\YT_BD\YT_BD\data\raw\videos.csv"
COMMENTS_CSV       = r"c:\JELLYFISH\YT_BD\YT_BD\data\raw\comments.csv"

# ---- Spark ----
SPARK_APP_NAME = "YouTubeBigDataAnalytics"
SPARK_MASTER   = "local[*]"

